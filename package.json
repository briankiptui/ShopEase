{
    "name":  "shopease-soa",
    "version":  "1.0.0",
    "description":  "ShopEase Service-Oriented E-commerce Platform",
    "main":  "api-gateway/server.js",
    "scripts":  {
                    "start":  "concurrently \"npm run gateway\" \"npm run users\" \"npm run products\" \"npm run cart\" \"npm run orders\" \"npm run payments\" \"npm run notifications\"",
                    "gateway":  "nodemon api-gateway/server.js",
                    "users":  "nodemon services/user-service/server.js",
                    "products":  "nodemon services/product-service/server.js",
                    "cart":  "nodemon services/cart-service/server.js",
                    "orders":  "nodemon services/order-service/server.js",
                    "payments":  "nodemon services/payment-service/server.js",
                    "notifications":  "nodemon services/notification-service/server.js",
                    "client":  "nodemon client/server.js",
                    "start:client":  "node client/server.js",
                    "start:gateway":  "node api-gateway/server.js",
                    "start:users":  "node services/user-service/server.js",
                    "start:products":  "node services/product-service/server.js",
                    "start:cart":  "node services/cart-service/server.js",
                    "start:orders":  "node services/order-service/server.js",
                    "start:payments":  "node services/payment-service/server.js",
                    "start:notifications":  "node services/notification-service/server.js"
                },
    "dependencies":  {
                         "axios":  "^1.21.0",
                         "bcryptjs":  "^3.0.3",
                         "cors":  "^2.8.6",
                         "dotenv":  "^18.0.9",
                         "express":  "^5.3.0",
                         "http-proxy-middleware":  "^3.0.10",
                         "jsonwebtoken":  "^9.0.3",
                         "mysql2":  "^3.24.6"
                     },
    "devDependencies":  {
                            "concurrently":  "^10.0.6",
                            "nodemon":  "^3.1.14"
                        }
}